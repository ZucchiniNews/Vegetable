@model Presentation.Models.ViewModels.WeatherViewModel

<form method="get">
    <input type="text" name="city" placeholder="Enter city" />
    <button type="submit">Search</button>
</form>

@if (Model != null && Model.Cities != null && Model.Cities.Any())
{
    <div class="current-weather">
        <h2>@Model.City</h2>
        <img src="@Model.IconUrl" alt="Weather icon" />
        <p>Current temperature: <strong>@Model.Temp °C</strong></p>
        <p>Description: @Model.Description</p>
    </div>

    <hr />

    <div class="charts-grid">
        @foreach (var cityChart in Model.Cities)
        {
            var canvasId = "chart-" + cityChart.City.ToLower().Replace(" ", "-");
            <div class="chart-card">
                <h3>@cityChart.City</h3>
                <canvas id="@canvasId"></canvas>
            </div>
        }
    </div>
}

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns@3.0.0/dist/chartjs-adapter-date-fns.bundle.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Ensure Model and Model.Cities are not null before serializing
            const rawData = @((Model != null && Model.Cities != null) ? Html.Raw(Json.Serialize(Model.Cities)) : "[]");
            
            // Helper to handle C# property casing
            const getProp = (obj, prop) => obj[prop.toLowerCase()] || obj[prop];

            if (!rawData || rawData.length === 0) return;

            // Calculate global Min/Max for Y-axis consistency
            const allTemps = rawData.flatMap(c => getProp(c, 'Temperatures'));
            const globalMin = Math.floor(Math.min(...allTemps) - 2);
            const globalMax = Math.ceil(Math.max(...allTemps) + 2);

        rawData.forEach(city => {
        const cityName = getProp(city, 'City');
        const canvasId = `chart-${cityName.replace(/\s+/g, '-').toLowerCase()}`;
        const ctx = document.getElementById(canvasId);

        if (!ctx) {
        console.warn("Could not find canvas for ID:", canvasId);
        return;
        }

                new Chart(ctx, {
                    type: 'line',
                    data: {
                        labels: getProp(city, 'Labels'),
                        datasets: [{
                            label: 'Temp (°C)',
                            data: getProp(city, 'Temperatures'),
                            borderColor: '#3498db',
                            backgroundColor: 'rgba(52, 152, 219, 0.1)',
                            fill: false,
                            tension: 0.3,
                            pointRadius: 2
                        }]
                    },
                    options: {
                         responsive: true,
                         maintainAspectRatio: false,
                         scales: {
                             x: {
                                 type: 'time',
                                 time: {
                                     parser: "yyyy-MM-dd'T'HH:mm:ss", 
                                     unit: 'hour',
                                     displayFormats: {
                                         hour: 'HH:mm'
                                     }
                                 },
                                 ticks: {
                                     source: 'data',
                                     autoSkip: true,
                                     maxTicksLimit: 6
                                 }
                             },
                             y: {
                                 min: globalMin,
                                 max: globalMax,
                                 // ticks: { stepSize: 2 },
                                 title: {
                                     display: true,
                                     text: '°C'
                                 }
                             }
                         },
                             plugins: {
                                 legend: { display: false }
                             }
                         }
                });
            });
        });
    </script>
}