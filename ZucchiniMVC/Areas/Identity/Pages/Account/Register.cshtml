@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="d-flex justify-content-center bg-light pt-5" style="min-height: 100vh;">
    <div class="card shadow-sm p-4" style="width: 420px; border-radius: 12px;">

        <div class="text-center mb-4">
            <h2 class="fw-bold">Create an Account</h2>
            <p class="text-muted">Join NewsDaily to stay informed with the latest news</p>
        </div>

        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Enter Your Name</label>
                <input asp-for="Input.FirstName" class="form-control form-control-lg mb-2" placeholder="First Name" />
                <input asp-for="Input.LastName" class="form-control form-control-lg" placeholder="Last Name" />
                <span asp-validation-for="Input.FirstName" class="text-danger"></span>
                <span asp-validation-for="Input.LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.DateOfBirth" class="form-label">Date of Birth</label>
                <input asp-for="Input.DateOfBirth" class="form-control form-control-lg" type="date" max="@ViewData["MaxDate"]" />
                <span asp-validation-for="Input.DateOfBirth" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label">Email Address</label>
                <input asp-for="Input.Email" class="form-control form-control-lg" placeholder="john@example.com" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control form-control-lg" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control form-control-lg" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button id="registerSubmit" type="submit" class="btn btn-dark w-100 btn-lg">
                Create Account
            </button>

            <div class="text-center mt-3">
                <span class="text-muted">Already have an account?</span>
                <a asp-page="./Login">Log In</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}