@page
@model PersonalDataModel
@{
    ViewData["Title"] = "Privacy";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<div class="container py-4 manage-container">
    
    @* The magic happens here *@
    <partial name="_ManageNav" />

    <div class="card card-settings mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center mb-1">
                <i class="bi bi-lock me-2 fs-5"></i>
                <h5 class="card-title mb-0 fw-bold">Privacy Settings</h5>
            </div>
            <p class="text-muted small mb-4">Control who can see your information and manage your data.</p>

            <form id="download-data" asp-page="DownloadPersonalData" method="post">
                <div class="d-flex justify-content-between align-items-center py-3 border-bottom">
                    <div>
                        <h6 class="mb-0 fw-bold">Download Personal Data</h6>
                        <small class="text-muted">Receive a copy of the data you have shared with us.</small>
                    </div>
                    <i class="bi bi-cloud-download fs-4 text-muted"></i>
                </div>
                <div class="mt-4">
                    <button type="submit" class="btn btn-dark w-100 fw-bold py-2">Download My Data</button>
                </div>
            </form>
        </div>
    </div>

    <div class="card danger-zone">
        <div class="card-body p-4">
            <h5 class="text-danger fw-bold mb-1">Danger Zone</h5>
            <p class="text-danger small mb-4">Irreversible actions that affect your account.</p>
            <a id="delete" asp-page="DeletePersonalData" class="btn btn-outline-danger w-100 bg-white py-2 fw-semibold rounded-3">
                Delete Account
            </a>
        </div>
    </div>
</div>