@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = "Security";
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<div class="container py-4 manage-container">
    
    <partial name="_ManageNav" />
    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="card card-settings">
        <div class="card-body p-4">
            <div class="d-flex align-items-center mb-1">
                <i class="bi bi-qr-code-scan me-2 fs-5"></i>
                <h5 class="card-title mb-0 fw-bold">Configure Authenticator App</h5>
            </div>
            <p class="text-muted small mb-4">Secure your account using a TOTP authenticator app.</p>

            <div class="row">
                <div class="col-lg-8">
                    <div class="mb-4">
                        <p class="fw-bold mb-2 small text-uppercase text-muted">Step 1: Download App</p>
                        <p class="small">
                            Download an app like <strong>Microsoft Authenticator</strong> or <strong>Google Authenticator</strong>
                            from your mobile device's app store.
                        </p>
                    </div>

                    <div class="mb-4">
                        <p class="fw-bold mb-2 small text-uppercase text-muted">Step 2: Scan QR Code</p>
                        <p class="small">Scan the QR code below or manually enter this setup key:</p>
                        <div class="p-2 bg-light border rounded-3 text-center mb-3">
                            <kbd class="bg-transparent text-dark fw-bold fs-6">@Model.SharedKey</kbd>
                        </div>
                        
                        <div class="d-flex justify-content-center my-3 p-3 bg-white border rounded-3 mx-auto" style="max-width: 200px;">
                            <div id="qrCode"></div>
                        </div>
                        <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
                        
                        <div class="alert alert-info border-0 shadow-none rounded-3 small py-2">
                            <i class="bi bi-info-circle me-2"></i>
                            Learn how to <a href="https://go.microsoft.com/fwlink/?Linkid=852423" class="alert-link">enable QR codes</a>.
                        </div>
                    </div>

                    <div class="mb-0">
                        <p class="fw-bold mb-2 small text-uppercase text-muted">Step 3: Verification</p>
                        <p class="small">Enter the 6-digit code generated by your app.</p>
                        
                        <form id="send-code" method="post">
                            <div class="mb-3">
                                <input asp-for="Input.Code" class="form-control form-control-lg text-center fw-bold"
                                       autocomplete="off" placeholder="000 000" maxlength="7" />
                                <span asp-validation-for="Input.Code" class="text-danger small"></span>
                            </div>
                            
                            <button type="submit" class="btn btn-dark w-100 fw-bold py-2 rounded-3">Verify & Activate</button>
                            <div asp-validation-summary="ModelOnly" class="text-danger mt-2 small" role="alert"></div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script type="text/javascript" src="~/lib/qrcode.js"></script>
    <script type="text/javascript" src="~/js/qr.js"></script>
}