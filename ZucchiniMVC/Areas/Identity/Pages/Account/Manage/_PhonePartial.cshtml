@model Zucchinimvc.Areas.Identity.Pages.Account.Manage.IndexModel

<div class="row">
    <div class="col-md-6">
        <h4 class="mb-3">Phone Number</h4>
        <form id="profile-form" method="post" asp-page-handler="ChangePhone">
            <div class="mb-3">
                <label asp-for="PhoneForm.NewPhoneNumber" class="form-label"></label>
                <input asp-for="PhoneForm.NewPhoneNumber" class="form-control" placeholder="Please enter your phone number." />
                <span asp-validation-for="PhoneForm.NewPhoneNumber" class="text-danger small"></span>
            </div>
            <button id="update-profile-button" type="submit" class="btn btn-dark">Save changes</button>
        </form>
    </div>
</div>