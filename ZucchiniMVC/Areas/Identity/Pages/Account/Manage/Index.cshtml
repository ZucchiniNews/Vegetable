@page
@model IndexModel
@{
    ViewData["Title"] = "User Settings";
}

<div class="container py-5">
    <h2 class="fw-bold mb-1">User Settings</h2>
    <p class="text-muted mb-4">Manage your account settings and preferences</p>

    <!-- Tabs -->
    <ul class="nav nav-pills mb-4 bg-light p-2 rounded-pill">
        <li class="nav-item">
            <a class="nav-link active rounded-pill px-4" href="#">Account</a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4" href="ChangePassword">Security</a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4" href="#">Notifications</a>
        </li>
        <li class="nav-item">
            <a class="nav-link rounded-pill px-4" href="PersonalData">Privacy</a>
        </li>
    </ul>

    <!-- Card -->
    <div class="card-user-management shadow-sm border-0 rounded-4 p-4">
        <h5 class="fw-semibold mb-3">Account</h5>

        <form id="profile-form" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Username -->
            <div class="mb-3">
                <label asp-for="Username" class="form-label"></label>
                <input asp-for="Username" class="form-control form-control-lg" disabled />
            </div>

            <!-- Phone -->
            <div class="mb-4">
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <input asp-for="Input.PhoneNumber" class="form-control form-control-lg" placeholder="+1 (555) 123-4567" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <button id="update-profile-button" type="submit" class="btn btn-dark px-4 py-2 rounded-3">
                Save Changes
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}