@page
@model IndexModel
@{
    ViewData["Title"] = "Account";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="container py-4 manage-container">
    
    <partial name="_ManageNav" />
    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="card card-settings mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center mb-1">
                <i class="bi bi-person-circle me-2 fs-5"></i>
                <h5 class="card-title mb-0 fw-bold">Profile Settings</h5>
            </div>
            <p class="text-muted small mb-4">Update your account information and how we contact you.</p>

            <form id="profile-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label class="form-label small fw-bold text-uppercase">Current Email</label>
                    <div class="input-group">
                        <input asp-for="Input.Email" class="form-control rounded-3 bg-light" disabled />
                        <a asp-page="./Email"
                           class="btn btn-outline-secondary btn-sm d-flex align-items-center">Change</a>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.PhoneNumber" class="form-label small fw-bold text-uppercase"></label>
                    <input asp-for="Input.PhoneNumber" class="form-control rounded-3" placeholder="(+46) 70-123 45 67"/>
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                </div>

                <button type="submit" class="btn btn-dark w-100 fw-bold py-2">Update Profile</button>
            </form>
        </div>

    
        @{
            if (User.IsInRole("Admin"))
            {
                <div class="card border rounded-4 shadow-sm"
                     style="background-color: #f0f7ff; border-color: #cce3ff !important;">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1">Content Management System</h6>
                                <p class="text-muted small mb-0">Manage articles</p>
                            </div>
                            <a class="btn btn-danger rounded-pill px-4" target="_blank"
                                   href="https://strapi-cms.orangeground-d9911dc7.northeurope.azurecontainerapps.io/admin">
                                Open CMS
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card border rounded-4 shadow-sm"
                     style="background-color: #f0f7ff; border-color: #cce3ff !important;">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1">Membership & Billing</h6>
                                <p class="text-muted small mb-0">Manage your subscription plan and payment methods.</p>
                            </div>
                            <a asp-controller="Subscription" asp-action="Index"
                                   class="btn btn-dark fw-bold rounded-pill px-4">
                                Manage <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>

    @section Scripts {
        <partial name="_ValidationScriptsPartial" />
    }