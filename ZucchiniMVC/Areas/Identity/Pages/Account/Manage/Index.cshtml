@page
@model IndexModel
@{
    ViewData["Title"] = "Manage your account";
}

<h3>@ViewData["Title"]</h3>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusType alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="p-4 border rounded-3 h-100 shadow-sm">
            <partial name="_ChangeEmailPartial" model="Model" />
        </div>
    </div>

    <div class="col-md-6">
        <div class="p-4 border rounded-3 h-100 shadow-sm">
            <partial name="_ChangePasswordPartial" model="Model" />
        </div>
    </div>

    <div class="col-md-6">
        <div class="p-4 border rounded-3 h-100 shadow-sm">
            <partial name="_PhonePartial" model="Model" />
        </div>
    </div>

    <div class="col-md-6">
        <div class="p-4 border rounded-3 h-100 shadow-sm">
            <partial name="_TwoFactorPartial" model="Model" />
        </div>
    </div>

    @{
        if (User.IsInRole("Admin"))
        {
            <div class="card border rounded-4 shadow-sm" style="background-color: #f0f7ff; border-color: #cce3ff !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">Content Management System</h6>
                            <p class="text-muted small mb-0">Manage articles</p>
                        </div>
                        <a class="btn btn-danger rounded-pill px-4" target="_blank" href="https://strapi-cms.orangeground-d9911dc7.northeurope.azurecontainerapps.io/admin">
                            Open CMS
                        </a>
                    </div>
                </div>
            </div>
        }
    }

    @if (Model.UserSubscription != null)
    {
        <div class="card border rounded-4 shadow-sm mb-4" style="background-color: #e6ffe6; border-color: #b3ffb3 !important;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-1">Your Subscription</h6>
                <p class="mb-1">Status: <span class="fw-bold">@Model.UserSubscription.Status</span></p>
                <p class="mb-1">Started: @Model.UserSubscription.Created.ToString("yyyy-MM-dd")</p>
                <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-primary bg-white fw-bold rounded-pill px-4 mt-2">
                    Manage Subscription <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border rounded-4 shadow-sm mb-4" style="background-color: #fffbe6; border-color: #ffe699 !important;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-1">No Active Subscription</h6>
                <p class="mb-1">You do not have an active subscription. Subscribe to access premium features.</p>
                <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-primary bg-white fw-bold rounded-pill px-4 mt-2">
                    View Plans <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    }
  
    <div class="col-12 mt-5">
        <div class="p-4 border border-danger rounded-3 bg-light-subtle">
            <h4 class="text-danger fw-bold">Danger Zone</h4>
            <hr class="text-danger">
            <partial name="_DeleteAccountPartial" model="Model" />
        </div>
    </div>

  
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}