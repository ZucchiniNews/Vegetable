@page
@model IndexModel
@{
    ViewData["Title"] = "Manage your account";
}

<div class="container py-4">

    <div class="mx-auto bg-white border rounded-4 shadow-sm overflow-hidden" style="max-width: 900px;">

        <!-- HEADER -->
        <div class="p-4 border-bottom">
            <h2 class="fw-bold mb-1">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">
                Manage your profile, security and subscription settings
            </p>
        </div>

        <!-- STATUS -->
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="px-4 pt-3">
                <div class="alert alert-@Model.StatusType shadow-sm border-0 rounded-3 mb-0">
                    @Model.StatusMessage
                </div>
            </div>
        }

        <div class="p-4 d-flex flex-column gap-4">

            <!-- SUBSCRIPTION -->
            <div>
                <div class="text-uppercase text-muted small fw-bold mb-2">
                    Subscription
                </div>

                <div class="p-4 border rounded-4 bg-success-subtle text-success-emphasis shadow-sm position-relative overflow-hidden">
                    <div class="position-absolute top-0 end-0 w-50 h-100 opacity-25" style="background: radial-gradient(circle at top right, rgba(255,255,255,.9), transparent 60%);"></div>

                    <div class="position-relative d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                        <div>
                            <div class="badge bg-success text-white rounded-pill px-3 py-2 mb-3">Premium Access</div>
                            <h4 class="fw-bold mb-2">Your subscription area</h4>
                            <p class="mb-0 text-success-emphasis">
                                View plans, manage your membership, and upgrade whenever you want.
                            </p>
                        </div>

                        <a class="btn btn-light text-success fw-semibold rounded-pill px-4 py-2 shadow-sm"
                           asp-controller="Subscription"
                           asp-action="Index">
                            View Subscription
                        </a>
                    </div>
                </div>
            </div>

            <!-- ACCOUNT -->
            <div>
                <div class="text-uppercase text-muted small fw-bold mb-2">
                    Account
                </div>

                <div class="d-flex flex-column gap-3">

                    <div class="p-3 p-lg-4 border rounded-4 bg-light">
                        <partial name="_ChangeEmailPartial" model="Model" />
                    </div>

                    <div class="p-3 p-lg-4 border rounded-4 bg-light">
                        <partial name="_PhonePartial" model="Model" />
                    </div>
                </div>
            </div>

            <!-- SECURITY -->
            <div>
                <div class="text-uppercase text-muted small fw-bold mb-2">
                    Security
                </div>

                <div class="d-flex flex-column gap-3">
                    <div class="p-3 p-lg-4 border rounded-4 bg-light">
                        <partial name="_ChangePasswordPartial" model="Model" />
                    </div>

                    <div class="p-3 p-lg-4 border rounded-4 bg-light">
                        <partial name="_TwoFactorPartial" model="Model" />
                    </div>
                </div>
            </div>

            <!-- ADMIN -->
            @if (User.IsInRole("Admin"))
            {
                <div>
                    <div class="text-uppercase text-muted small fw-bold mb-2">
                        Admin
                    </div>

                    <div class="p-3 border rounded-4 bg-primary-subtle d-flex justify-content-between align-items-center gap-3">
                        <div>
                            <div class="fw-bold">Content Management</div>
                            <div class="text-muted small">
                                Manage articles and CMS content
                            </div>
                        </div>

                        <a class="btn btn-danger rounded-pill px-4"
                           target="_blank"
                           href="https://strapi-cms.orangeground-d9911dc7.northeurope.azurecontainerapps.io/admin">
                            Open CMS
                        </a>
                    </div>
                </div>
            }

            <!-- DANGER ZONE -->
            <div>
                <div class="text-uppercase text-danger small fw-bold mb-2">
                    Danger Zone
                </div>

                <div class="p-3 border border-danger-subtle rounded-4 bg-danger-subtle">
                    <partial name="_DeleteAccountPartial" model="Model" />
                </div>
            </div>

        </div>
    </div>
</div>