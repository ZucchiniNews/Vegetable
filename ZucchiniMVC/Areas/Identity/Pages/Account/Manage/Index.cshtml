@page
@model IndexModel
@{
    ViewData["Title"] = "Manage your account";
}

<h3>@ViewData["Title"]</h3>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    <div class="alert alert-@Model.StatusType alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-5">
    <div class="col-12 border-bottom pb-4">
        <partial name="_ChangeEmailPartial" model="Model" />
    </div>

    <div class="col-12 border-bottom pb-4">
        <partial name="_ChangePasswordPartial" model="Model" />
    </div>

    <div class="col-12 border-bottom pb-4">
        <partial name="_PhonePartial" model="Model" />
    </div>

    <div class="col-12 border-bottom pb-4">
        <partial name="_TwoFactorPartial" model="Model" />
    </div>

    <div class="col-12 text-danger">
        <partial name="_DeleteAccountPartial" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}