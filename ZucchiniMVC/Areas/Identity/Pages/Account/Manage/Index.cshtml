@page
@model IndexModel
@{
    ViewData["Title"] = "Account settings";
}

<div class="container py-4 manage-container">
    <h2 class="mb-4 fw-bold">Account settings</h2>

    <partial name="_StatusMessage" for="StatusMessage" />

    <ul class="nav nav-tabs mb-4 border-bottom-0" id="manageTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab">
                <i class="bi bi-person-circle me-1"></i> Profile
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="security-tab" data-bs-toggle="tab" data-bs-target="#security" type="button" role="tab">
                <i class="bi bi-shield-lock me-1"></i> Security
            </button>
        </li>
        @if (!User.IsInRole("Admin"))
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="billing-tab" data-bs-toggle="tab" data-bs-target="#billing" type="button" role="tab">
                    <i class="bi bi-credit-card me-1"></i> Billing
                </button>
            </li>
        }
    </ul>

    <div class="tab-content" id="manageTabContent">
        <div class="tab-pane fade show active" id="profile" role="tabpanel">
            <div class="card card-settings border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Profile Information</h5>
                    <p class="text-muted small mb-4">Update your basic account details.</p>
                    
                    <form id="profile-form" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>
                        
                        <div class="mb-3">
                            <label class="form-label small fw-bold text-uppercase">Email</label>
                            <input asp-for="Input.Email" class="form-control rounded-3 bg-light" disabled />
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.PhoneNumber" class="form-label small fw-bold text-uppercase"></label>
                            <input asp-for="Input.PhoneNumber" class="form-control rounded-3" placeholder="(+46) 70-123 45 67"/>
                            <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 fw-bold py-2">Update Profile</button>
                    </form>
                </div>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <div class="card border-0 rounded-4 shadow-sm mt-4" style="background-color: #f0f7ff;">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1">Content Management System</h6>
                                <p class="text-muted small mb-0">Manage articles and site content.</p>
                            </div>
                            <a class="btn btn-danger rounded-pill px-4" target="_blank" href="https://strapi-cms-url-here/admin">
                                Open CMS
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="tab-pane fade" id="security" role="tabpanel">
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold">Security Settings</h5>
                    <p class="text-muted small mb-4">Manage your password and two-factor authentication.</p>
                    
                    <div class="list-group list-group-flush">
                        <a asp-page="./Email" class="list-group-item list-group-item-action py-3 d-flex justify-content-between align-items-center border-0 border-bottom">
                            <span><i class="bi bi-envelope me-2"></i> Change Email</span>
                            <i class="bi bi-chevron-right small text-muted"></i>
                        </a>
                        <a asp-page="./ChangePassword" class="list-group-item list-group-item-action py-3 d-flex justify-content-between align-items-center border-0 border-bottom">
                            <span><i class="bi bi-key me-2"></i> Change Password</span>
                            <i class="bi bi-chevron-right small text-muted"></i>
                        </a>
                        <a asp-page="./TwoFactorAuthentication" class="list-group-item list-group-item-action py-3 d-flex justify-content-between align-items-center border-0">
                            <span><i class="bi bi-shield-check me-2"></i> Two-Factor Auth</span>
                            <i class="bi bi-chevron-right small text-muted"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        @if (!User.IsInRole("Admin"))
        {
            <div class="tab-pane fade" id="billing" role="tabpanel">
                <div class="card border-0 rounded-4 shadow-sm" style="background-color: #f0f7ff;">
                    <div class="card-body p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="fw-bold mb-1">Membership & Billing</h6>
                                <p class="text-muted small mb-0">Manage your subscription plan and payment methods.</p>
                            </div>
                            <a asp-controller="Subscription" asp-action="Index" class="btn btn-dark fw-bold rounded-pill px-4">
                                Manage <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Store and restore the active tab using localStorage so it persists across refreshes
        document.addEventListener("DOMContentLoaded", function() {
            const activeTab = localStorage.getItem('activeAccountTab');
            if (activeTab) {
                const tabTrigger = new bootstrap.Tab(document.querySelector(`[data-bs-target="${activeTab}"]`));
                tabTrigger.show();
            }

            const tabEls = document.querySelectorAll('button[data-bs-toggle="tab"]');
            tabEls.forEach(el => {
                el.addEventListener('shown.bs.tab', function (event) {
                    localStorage.setItem('activeAccountTab', event.target.getAttribute('data-bs-target'));
                });
            });
        });
    </script>
}