@page
@model IndexModel
@{
    ViewData["Title"] = "Account";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<div class="container py-4 manage-container">
    
    <partial name="_ManageNav" />
    <partial name="_StatusMessage" for="StatusMessage" />

    <div class="card card-settings mb-4">
        <div class="card-body p-4">
            <div class="d-flex align-items-center mb-1">
                <i class="bi bi-person-circle me-2 fs-5"></i>
                <h5 class="card-title mb-0 fw-bold">Profile Settings</h5>
            </div>
            <p class="text-muted small mb-4">Update your account information and how we contact you.</p>

            <form id="profile-form" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Username" class="form-label small fw-bold text-uppercase" style="letter-spacing: 0.05em;"></label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 rounded-start-3"><i class="bi bi-at"></i></span>
                        <input asp-for="Username" class="form-control bg-light border-start-0 rounded-end-3" disabled />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Input.PhoneNumber" class="form-label small fw-bold text-uppercase" style="letter-spacing: 0.05em;"></label>
                    <input asp-for="Input.PhoneNumber" class="form-control rounded-3" placeholder="e.g. +1 (555) 000-0000" />
                    <span asp-validation-for="Input.PhoneNumber" class="text-danger small"></span>
                </div>

                <button id="update-profile-button" type="submit" class="btn btn-dark w-100 fw-bold py-2 rounded-3">
                    Save Changes
                </button>
            </form>
        </div>
    </div>

    @{
        if (User.IsInRole("Admin"))
        {
            <div class="card border rounded-4 shadow-sm" style="background-color: #f0f7ff; border-color: #cce3ff !important;">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <h6 class="fw-bold mb-1">Content Management System</h6>
                            <p class="text-muted small mb-0">Manage articles</p>
                        </div>
                        <a class="btn btn-danger rounded-pill px-4" target="_blank" href="https://strapi-cms.orangeground-d9911dc7.northeurope.azurecontainerapps.io/admin">
                            Open CMS
                        </a>
                    </div>
                </div>
            </div>
        }
    }

    @if (Model.UserSubscription != null)
    {
        <div class="card border rounded-4 shadow-sm mb-4" style="background-color: #e6ffe6; border-color: #b3ffb3 !important;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-1">Your Subscription</h6>
                <p class="mb-1">Status: <span class="fw-bold">@Model.UserSubscription.Status</span></p>
                <p class="mb-1">Started: @Model.UserSubscription.Created.ToString("yyyy-MM-dd")</p>
                <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-primary bg-white fw-bold rounded-pill px-4 mt-2">
                    Manage Subscription <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card border rounded-4 shadow-sm mb-4" style="background-color: #fffbe6; border-color: #ffe699 !important;">
            <div class="card-body p-4">
                <h6 class="fw-bold mb-1">No Active Subscription</h6>
                <p class="mb-1">You do not have an active subscription. Subscribe to access premium features.</p>
                <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-primary bg-white fw-bold rounded-pill px-4 mt-2">
                    View Plans <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}