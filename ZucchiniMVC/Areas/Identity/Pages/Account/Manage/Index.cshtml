@page
@model IndexModel
@{
    ViewData["Title"] = "Manage your account";
}

<div class="container py-4">

    <div class="mx-auto bg-white border rounded-4 shadow-sm overflow-hidden" style="max-width: 900px;">

        <!-- HEADER -->
        <div class="p-4 border-bottom">
            <h2 class="fw-bold mb-1">@ViewData["Title"]</h2>
            <p class="text-muted mb-0">
                Manage your profile, security and subscription settings
            </p>
        </div>

        <!-- STATUS -->
        @if (!string.IsNullOrEmpty(Model.StatusMessage))
        {
            <div class="px-4 pt-3">
                <div class="alert alert-@Model.StatusType shadow-sm border-0 rounded-3 mb-0">
                    @Model.StatusMessage
                </div>
            </div>
        }

        <div class="p-4 d-flex flex-column gap-4">

            <!-- ACCOUNT -->
            <div>
                <div class="text-uppercase text-muted small fw-bold mb-2">
                    Account
                </div>

                <div class="row g-3">

                    <div class="col-12 col-lg-6">
                        <div class="p-3 border rounded-4 h-100 d-flex flex-column gap-2 w-100">
                            <div class="w-100">
                                <partial name="_ChangeEmailPartial" model="Model" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="p-3 border rounded-4 h-100 d-flex flex-column gap-2 w-100">
                            <div class="w-100">
                                <partial name="_PhonePartial" model="Model" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="p-3 border rounded-4 h-100 d-flex flex-column gap-2 w-100">
                            <div class="w-100">
                                <div class="text-muted small fw-bold mb-1">
                                    Subscription
                                </div>
                                <div class="text-muted mb-3">
                                    View plans and manage your subscription.
                                </div>
                                <a class="btn btn-dark rounded-pill px-4" asp-controller="Subscription" asp-action="Index">
                                    View Subscription
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- SECURITY -->
            <div>
                <div class="text-uppercase text-muted small fw-bold mb-2">
                    Security
                </div>

                <div class="row g-3">

                    <div class="col-12 col-lg-6">
                        <div class="p-3 border rounded-4 h-100 d-flex flex-column gap-2 w-100">
                            <div class="w-100">
                                <partial name="_ChangePasswordPartial" model="Model" />
                            </div>
                        </div>
                    </div>

                    <div class="col-12 col-lg-6">
                        <div class="p-3 border rounded-4 h-100 d-flex flex-column gap-2 w-100">
                            <div class="w-100">
                                <partial name="_TwoFactorPartial" model="Model" />
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <!-- ADMIN -->
            @if (User.IsInRole("Admin"))
            {
                <div>
                    <div class="text-uppercase text-muted small fw-bold mb-2">
                        Admin
                    </div>

                    <div class="p-3 border rounded-4 bg-primary-subtle d-flex justify-content-between align-items-center">

                        <div>
                            <div class="fw-bold">Content Management</div>
                            <div class="text-muted small">
                                Manage articles and CMS content
                            </div>
                        </div>

                        <a class="btn btn-danger rounded-pill px-4"
                               target="_blank"
                               href="https://strapi-cms.orangeground-d9911dc7.northeurope.azurecontainerapps.io/admin">
                            Open CMS
                        </a>

                    </div>
                </div>
            }

            <!-- DANGER ZONE -->
            <div>
                <div class="text-uppercase text-danger small fw-bold mb-2">
                    Danger Zone
                </div>

                <div class="p-3 border border-danger-subtle rounded-4 bg-danger-subtle">
                    <div class="w-100">
                        <partial name="_DeleteAccountPartial" model="Model" />
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>