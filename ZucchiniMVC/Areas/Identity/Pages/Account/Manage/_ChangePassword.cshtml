@model Zucchinimvc.Areas.Identity.Pages.Account.Manage.ManageModel

<div class="row">
    <div class="col-md-6">
        <h4 class="mb-3">Change password</h4>

        @if (!Model.HasPassword)
        {
            <div class="alert alert-info">
                You don't have a local password set. If you signed in via an external provider,
                you can <a asp-page="/Account/Manage/SetPassword">set a password here</a>.
            </div>
        }
        else
        {
            <form method="post" asp-page-handler="ChangePassword">
                <div class="mb-3">
                    <label asp-for="PasswordForm.CurrentPassword" class="form-label"></label>
                    <input asp-for="PasswordForm.CurrentPassword" class="form-control" />
                    <span asp-validation-for="PasswordForm.CurrentPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PasswordForm.NewPassword" class="form-label"></label>
                    <input asp-for="PasswordForm.NewPassword" class="form-control" />
                    <span asp-validation-for="PasswordForm.NewPassword" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="PasswordForm.ConfirmPassword" class="form-label"></label>
                    <input asp-for="PasswordForm.ConfirmPassword" class="form-control" />
                    <span asp-validation-for="PasswordForm.ConfirmPassword" class="text-danger small"></span>
                </div>
                <button type="submit" class="btn btn-primary">Update password</button>
            </form>
        }
    </div>
</div>
