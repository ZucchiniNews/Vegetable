@page
@model Zucchinimvc.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Account settings";
}

<h1 class="mb-4">Account settings</h1>

@if (!string.IsNullOrEmpty(Model.StatusMessage))
{
    var alertClass = Model.StatusType == "success" ? "alert-success" : "alert-danger";
    <div class="alert @alertClass alert-dismissible fade show" role="alert">
        @Model.StatusMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<ul class="nav nav-tabs mb-4" id="manageTabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="profile-tab" data-bs-toggle="tab"
                data-bs-target="#profile" type="button" role="tab">
            Profile
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="email-tab" data-bs-toggle="tab"
                data-bs-target="#email" type="button" role="tab">
            Email
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="password-tab" data-bs-toggle="tab"
                data-bs-target="#password" type="button" role="tab">
            Password
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="security-tab" data-bs-toggle="tab"
                data-bs-target="#security" type="button" role="tab">
            Two-factor auth
        </button>
    </li>
</ul>

<div class="tab-content" id="manageTabContent">
    <div class="tab-pane fade show active" id="profile" role="tabpanel">
        <partial name="_ChangeName" model="Model" />
    </div>
    <div class="tab-pane fade" id="email" role="tabpanel">
        <partial name="_ChangeEmail" model="Model" />
    </div>
    <div class="tab-pane fade" id="password" role="tabpanel">
        <partial name="_ChangePassword" model="Model" />
    </div>
    <div class="tab-pane fade" id="security" role="tabpanel">
        <partial name="_TwoFactor" model="Model" />
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    @* Re-open the tab that had a validation error or status update *@
    <script>
        (function () {
            const hash = window.location.hash;
            if (hash) {
                const tab = document.querySelector(`[data-bs-target="${hash}"]`);
                if (tab) new bootstrap.Tab(tab).show();
            }
        })();
    </script>
}
