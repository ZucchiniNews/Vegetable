
@model List<ZucchiniCore.Entities.Plan>

@{
    ViewData["Title"] = "Choose Plan";
}

<div class="container py-5">

    <!-- Header -->
    <div class="text-center mb-5">
        <h1 class="fw-bold display-5">Choose Your Plan</h1>
        <p class="lead text-muted">
            Get unlimited access to ZucchiniNews and premium content.
        </p>
    </div>

    <form method="post" action="/Subscription/Subscribe">

        <!-- Plans -->
        <div class="row justify-content-center g-4 mb-5">

            @foreach (var plan in Model)
            {
                var isPopular = plan.Name.ToLower().Contains("pro") || plan.Name.ToLower().Contains("premium");

                <div class="col-md-4">
                    <div class="card pricing-card h-100 shadow-sm border-0 @(isPopular ? "border border-primary border-2" : "")">

                        @if (isPopular)
                        {
                            <div class="badge bg-primary position-absolute top-0 start-50 translate-middle px-3 py-2">
                                Most Popular
                            </div>
                        }

                        <div class="card-body text-center d-flex flex-column p-4">

                            <h5 class="fw-bold text-uppercase text-muted mb-3">@plan.Name</h5>

                            <h2 class="fw-bold mb-3">
                                @plan.Price SEK
                                <span class="fs-6 text-muted">/month</span>
                            </h2>

                            <p class="text-muted mb-4">@plan.Description</p>

                            <div class="mt-auto">
                                <div class="form-check d-flex justify-content-center">
                                    <input class="form-check-input me-2"
                                           type="radio"
                                           id="plan_@plan.Id"
                                           name="planId"
                                           value="@plan.Id"
                                           required />

                                    <label class="form-check-label fw-semibold"
                                           for="plan_@plan.Id">
                                        Select
                                    </label>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            }

        </div>

        <!-- CTA -->
        <div class="text-center">
            <button type="submit"
                    class="btn btn-primary btn-lg px-5 py-3 rounded-pill shadow-sm">
                Continue to Checkout →
            </button>
        </div>

    </form>
</div>

