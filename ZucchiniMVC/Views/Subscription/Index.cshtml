@{
    ViewData["Title"] = "Choose Plan";
}

<h1>Choose Plan</h1>

<div class="row justify-content-center mt-5">
    <div class="col-md-8 text-center mb-4">
        <p class="lead">Select the plan that works best for you and get unlimited access to ZicchiniNews.</p>
    </div>
</div>

@model List<ZucchiniCore.Entities.Plan>
<form method="post" action="/Subscription/Subscribe">
    <div class="row mb-4">
        <div class="col-12 text-center">
            <button type="submit" class="btn btn-success btn-lg px-5 rounded-pill shadow">Complete Subscription</button>
        </div>
    </div>
    <div class="row justify-content-center">
        @foreach (ZucchiniCore.Entities.Plan plan in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-header bg-primary text-white text-center py-3">
                        <h4 class="my-0 fw-normal">@plan.Name</h4>
                    </div>
                    <div class="card-body text-center d-flex flex-column">
                        <h1 class="card-title pricing-card-title">@plan.Price SEK<small class="text-muted fw-light">/@plan.Name</small></h1>
                        <ul class="list-unstyled mt-3 mb-4 flex-grow-1">
                            <li>@plan.Description</li>
                        </ul>
                        <div class="form-check d-flex justify-content-center mt-auto">
                            <input class="form-check-input me-2" type="radio" id="plan_@plan.Id" name="planId" value="@plan.Id" required style="cursor: pointer;" />
                            <label class="form-check-label fw-bold" for="plan_@plan.Id" style="cursor: pointer;">Select @plan.Name</label>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</form>

