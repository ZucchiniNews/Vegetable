@using Zucchinimvc.Models.ViewModels
@model ArticleViewModel

@{
    ViewData["Title"] = Model.Article.Title;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="article-header mb-4">
                <h1 class="fw-bold mb-3">@Model.Article.Title</h1>
                <div class="article-meta text-muted mb-4 d-flex align-items-center gap-3">
                    <span>Published on @Model.Article.PublishedAt.ToString("MMMM dd, yyyy")</span>
                    <span>@Model.Article.ReadingTimeMinutes min read</span>
                </div>
            </div>

            @if (Model.Article.Cover != null)
            {
                <div class="article-image mb-5">
                    <img src="@Model.Article.Cover.OriginalUrl" alt="@Model.Article.Title" class="img-fluid rounded w-100 shadow-sm" style="max-height: 500px; object-fit: cover;" />
                </div>
            }

            <div class="article-interaction my-4">
                @if (User.Identity.IsAuthenticated)
                {
                    <button id="likeButton"
                            class="btn @(Model.IsLikedByCurrentUser ? "btn-danger" : "btn-outline-danger")"
                            onclick="toggleLike(@Model.Article.Id)">
                        <i class="@(Model.IsLikedByCurrentUser ? "fas" : "far") fa-heart"></i>
                        <span id="likeCount">@Model.LikeCount</span> Likes
                    </button>
                }
                else
                {
                    <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-secondary">
                        <i class="far fa-heart"></i> @Model.LikeCount Likes
                    </a>
                }
            </div>

            @* <div class="like-section" data-article-id="@Model.Article.Id">
                <button id="like-btn" class="@(Model.IsLikedByCurrentUser ? "liked" : "")"
                    @(User.Identity!.IsAuthenticated ? "" : "disabled")>
                    ? <span id="like-count">@Model.LikeCount</span>
                </button>
            </div> *@

            <div class="article-content" style="font-size: 1.15rem; line-height: 1.8;">
                <p class="lead fw-bold mb-4">@Model.Article.ContentSummary</p>
                
                <p>@Model.Article.BodyPreview</p>

                @if (Model.IsSubscribed || User.IsInRole("Admin"))
                {
                    <p>@Model.Article.BodyGated</p>
                }
                else
                {
                    <div class="border rounded p-5 text-center bg-light mt-4">
                        <h4 class="fw-bold mb-2">This content is for subscribers only</h4>
                        <p class="text-muted mb-4">Subscribe to get full access to this article and all premium content.</p>
                        <a asp-controller="Subscription" asp-action="Index" class="btn btn-primary px-4">Subscribe Now</a>
                    </div>
                }
            </div>
            
            <div class="mt-5 pt-4 border-top">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">&larr; Back to Home</a>
            </div>
        </div>
    </div>
</div>



<script>
    async function toggleLike(articleId) {
        const response = await fetch(`/Articles/ToggleLike?articleId=${articleId}`, {
            method: 'POST',
            headers: { 'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value }
        });
    
        if (response.ok) {
            const data = await response.json();
            document.getElementById('likeCount').innerText = data.count;
        
            // Toggle UI styles
            const btn = document.getElementById('likeButton');
            btn.classList.toggle('btn-danger');
            btn.classList.toggle('btn-outline-danger');
            btn.querySelector('i').classList.toggle('fas');
            btn.querySelector('i').classList.toggle('far');
        }
    }
</script>


