@model ZucchiniCore.Entities.Article

@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="article-header mb-4">
                <h1 class="fw-bold mb-3">@Model.Title</h1>

                <div class="article-meta text-muted mb-4 d-flex align-items-center gap-3">
                    <span>Published on @Model.PublishedAt.ToString("MMMM dd, yyyy")</span>
                    <span>@Model.ReadingTimeMinutes min read</span>
                </div>
            </div>

            @if (Model.Cover != null)
            {
                <div class="article-image mb-5">
                    <img src="@Model.Cover.OriginalUrl"
                         alt="@Model.Title"
                         class="img-fluid rounded w-100 shadow-sm"
                         style="max-height: 500px; object-fit: cover;" />
                </div>
            }

            <div class="article-interaction my-4">
                @if (User.Identity.IsAuthenticated)
                {
                    <button id="like-btn"
                            class="btn @(Model.IsLikedByCurrentUser ? "btn-danger" : "btn-outline-danger")"
                            onclick="toggleLike(@Model.Article.Id)">
                        <i class="@(Model.IsLikedByCurrentUser ? "fas" : "far") fa-heart"></i>
                        <span id="likeCount">@Model.LikeCount</span> Likes
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-secondary" onclick="showLoginPrompt()">
                        <i class="far fa-heart"></i> @Model.LikeCount Likes
                    </button>
                }
            </div>

            <div class="modal fade" id="loginPromptModal" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header border-0">
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body text-center pb-4">
                            <i class="far fa-heart fa-3x text-danger mb-3"></i>
                            <h5 class="fw-bold">Enjoying this article?</h5>
                            <p class="text-muted">Sign in to like and save your favourite articles.</p>
                            <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary px-4 me-2">Sign in</a>
                            <button class="btn btn-outline-secondary px-4" data-bs-dismiss="modal">Maybe later</button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="article-content" style="font-size: 1.15rem; line-height: 1.8;">
                <p class="lead fw-bold mb-4">@Model.ContentSummary</p>

                <p>@Model.BodyPreview</p>

                @await Component.InvokeAsync("SubscriptionGate", new
                {
                    body = Model.BodyGated,
                    isAdmin = User.IsInRole("Admin")
                })
            </div>

            <div class="mt-5 pt-4 border-top">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                    &larr; Back to Home
                </a>
            </div>

        </div>
    </div>
</div>


@section Scripts {
    @Html.AntiForgeryToken()
    <script>
        function showLoginPrompt() {
            new bootstrap.Modal(document.getElementById('loginPromptModal')).show()
        }



        async function toggleLike(articleId) {
            const res = await fetch('/article/toggle-like', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                },
                body: JSON.stringify({ articleId: articleId })
            });

            if (!res.ok) return;

            const data = await res.json();
            document.getElementById('likeCount').innerText = data.likeCount;

            const btn = document.getElementById('like-btn');
            btn.classList.toggle('btn-danger');
            btn.classList.toggle('btn-outline-danger');
            btn.querySelector('i').classList.toggle('fas');
            btn.querySelector('i').classList.toggle('far');
        }
    </script>
}
</div>
