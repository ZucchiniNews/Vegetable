@using ZucchiniCore.Entities
@model Article

@{
    ViewData["Title"] = Model.Title;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">

            <div class="article-header mb-4">
                <h1 class="fw-bold mb-3">@Model.Title</h1>

                <div class="article-meta text-muted mb-4 d-flex align-items-center gap-3">
                    <span>Published on @Model.PublishedAt.ToString("MMMM dd, yyyy")</span>
                    <span>@Model.ReadingTimeMinutes min read</span>
                </div>
            </div>

            @if (Model.Cover != null)
            {
                <div class="article-image mb-5">
                    <img src="@Model.Cover.OriginalUrl"
                         alt="@Model.Title"
                         class="img-fluid rounded w-100 shadow-sm"
                         style="max-height: 500px; object-fit: cover;" />
                </div>
            }

            <div class="article-content" style="font-size: 1.15rem; line-height: 1.8;">
                <p class="lead fw-bold mb-4">@Model.ContentSummary</p>

                <p>@Model.BodyPreview</p>

                @await Component.InvokeAsync("SubscriptionGate", new
                {
                    body = Model.BodyGated,
                    isAdmin = User.IsInRole("Admin")
                })
            </div>

            <div class="mt-5 pt-4 border-top">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                    &larr; Back to Home
                </a>
            </div>

        </div>
    </div>
</div>