
@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-9">

            <div class="bg-white shadow-sm rounded-4 p-5 border">

                <div class="mb-5 text-center">
                    <h1 class="display-5 fw-bold mb-3">Privacy Policy</h1>
                    <p class="text-muted fs-6 mb-0">
                        Last updated: @DateTime.Now.ToString("MMMM dd, yyyy")
                    </p>
                </div>

                <div class="mb-5">
                    <h2 class="h3 fw-semibold mb-3">Your Privacy Matters</h2>

                    <p class="text-secondary lh-lg">
                        At Zucchini News, we respect your privacy and are committed to protecting your personal information.
                        This page explains how cookies are used on our website and how they help improve your browsing experience.
                    </p>
                </div>

                <div class="mb-5">
                    <div class="d-flex align-items-center mb-3">
                        <div class="bg-dark text-white rounded-circle d-flex align-items-center justify-content-center me-3"
                             style="width: 45px; height: 45px;">
                            🍪
                        </div>
                        <h2 class="h3 fw-semibold mb-0">Cookies</h2>
                    </div>

                    <p class="text-secondary lh-lg">
                        Cookies are small text files stored on your device when you visit a website.
                        They help websites remember information about your visit, making your experience faster,
                        safer, and more personalized.
                    </p>
                </div>

                <div class="mb-5">
                    <h2 class="h3 fw-semibold mb-4">Types of Cookies We Use</h2>

                    <div class="row g-4">

                        <div class="col-md-6">
                            <div class="border rounded-4 p-4 h-100 bg-light">
                                <h3 class="h5 fw-bold mb-3">Essential Cookies</h3>
                                <p class="text-secondary mb-0 lh-lg">
                                    These cookies are required for the website to function properly.
                                    They support core features such as security, page navigation,
                                    and basic website functionality.
                                </p>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="border rounded-4 p-4 h-100 bg-light">
                                <h3 class="h5 fw-bold mb-3">Consent Cookies</h3>
                                <p class="text-secondary mb-0 lh-lg">
                                    These cookies remember your cookie preferences so the cookie banner
                                    does not appear every time you visit the website.
                                </p>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="mb-5">
                    <h2 class="h3 fw-semibold mb-3">Managing Cookies</h2>

                    <p class="text-secondary lh-lg mb-3">
                        You can manage or disable cookies through your browser settings.
                        Please note that disabling some cookies may affect certain features
                        and functionality of the website.
                    </p>

                    <div class="alert alert-secondary rounded-4 border-0">
                        <strong>Tip:</strong> Most modern browsers allow you to clear cookies,
                        block specific websites, or receive notifications when cookies are being used.
                    </div>
                </div>

                <hr class="my-5" />

                <div>
                    <h2 class="h3 fw-semibold mb-3">Contact Us</h2>

                    <p class="text-secondary lh-lg mb-2">
                        If you have any questions regarding this Privacy Policy,
                        feel free to contact us.
                    </p>

                    <div class="bg-light rounded-4 p-4 border">
                        <strong>Email:</strong>
                        zucchininews@gmail.com
                    </div>
                </div>

            </div>

        </div>
    </div>
</div>

