@using ZucchiniCore.Entities
@model IEnumerable<Article>

@{
    ViewData["Title"] = "Articles Index";
    var isHome = ViewData["IsHome"] as bool? == true;
}

@if (isHome)
{
<section class="featured-section">
    <div class="featured-image">
        <img src="https://images.unsplash.com/photo-1504711434969-e33886168f5c?q=80&w=1200&auto=format&fit=crop" alt="Featured news" />
        <span class="featured-badge">Featured</span>
    </div>

    <div class="featured-content">
        <span class="news-tag">Environment</span>
        <h1>Global Climate Summit Reaches Historic Agreement</h1>
        <p>
            World leaders commit to stronger climate action and new emissions targets,
            marking one of the most significant environmental agreements in recent years.
        </p>

        <div class="news-meta">
            <span>March 25, 2026</span>
            <span>5 min read</span>
        </div>
    </div>
</section>

<section class="weather-section">
    <div class="weather-card">
        <h2>Weather</h2>
        <p class="mb-2">Current update for your selected city</p>

        <div class="mt-3">
            @{
                var city = Context.Request.Query["city"].ToString();
            }
            @await Component.InvokeAsync("Weather", new { city })
        </div>
    </div>
</section>
}

<section class="latest-news-section">
    <h2>Latest News</h2>

    <div class="news-grid">
        @foreach (var article in Model)
        {
            <article class="news-card">
                <img src="@article.Cover?.Url" alt="@article.Title" />

                <div class="news-card-body">
                    <span class="news-tag light">News</span>

                    <h3>@article.Title</h3>

                    <div class="news-meta">
                        <span>@article.PublishedAt.ToString("MMMM dd, yyyy")</span>
                        <span>5 min read</span>
                    </div>
                </div>
            </article>
        }
    </div>
</section>