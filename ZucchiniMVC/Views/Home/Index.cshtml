@using Zucchinimvc.Models.ViewModels;
@model HomeIndexViewModel

@{
    ViewData["Title"] = "Home";
}

<section class="hero-layout">
    
    <div class="featured-column">
        @if (Model.FeaturedArticle != null)
        {
            var featured = Model.FeaturedArticle;

            <a href="/article/@featured.Article.Slug">
                <section class="featured-hero" style="background-image: url('@featured.Article.Cover?.OriginalUrl')">
                    <div class="featured-overlay">
                        <div class="featured-content">
                            <span class="badge badge-featured">Featured</span>
                            @if (featured.Article.Category != null)
                            {
                                <span class="badge badge-category">@featured.Article.Category.Name.ToUpper()</span>
                            }
                            <h1 class="featured-title">@featured.Article.Title</h1>
                            <p class="featured-excerpt">@featured.Article.ContentSummary</p>
                            <div class="featured-meta">
                                <span>📅 @featured.Article.PublishedAt.ToString("MMM d, yyyy")</span>
                                <span>🕐 @featured.ReadTimeMin min read</span>
                            </div>
                        </div>
                    </div>
                </section>
            </a>
        }
    </div>

    <div class="recommend-column">
        <partial name="_RecommendedArticlesPartial"
                 model="Model.RecommendArticles" />
    </div>

</section>

@if (Model.EditorsChoiceArticles.Any())
{
    <section class="section editors-choice-section">
        <div class="section-header">
            <span class="section-icon">⭐</span>
            <h2 class="section-title">Editor's Choice</h2>
        </div>
        <div class="editors-grid">
            @foreach (var article in Model.EditorsChoiceArticles)
            {
                <a href="/article/@article.Article.Slug" class="editor-card">
                    <div class="editor-card-image">
                        <img src="@article.Article.Cover?.DisplayUrl" alt="@article.Article.Title" />
                        <span class="badge badge-editors-pick">Editor's Pick</span>
                    </div>
                    <div class="editor-card-body">
                        <span class="card-category">@article.Article.Category?.Name.ToUpper()</span>
                        <h3 class="card-title">@article.Article.Title</h3>
                        <p class="card-excerpt">@(article.Article.ContentSummary.Length > 80 ? (article.Article.ContentSummary[..80] + "...") : article.Article.ContentSummary)</p>
                        <div class="card-meta">
                            <span>📅 @article.Article.PublishedAt.ToString("MMM d, yyyy")</span>
                            <span>🕐 @article.ReadTimeMin min read</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </section>
}

@if (Model.LatestArticles?.Any() == true)
{


    <section class="section latest-news-section">
        <div class="section-header">
            <span class="section-icon">↗</span>
            <h2 class="section-title">Latest News</h2>
        </div>
        <div class="editors-grid latest-grid">
            @foreach (var article in Model.LatestArticles)
            {
                <partial name="_NewscardPartial" model="article" />
            }
        </div>
    </section>
    
}