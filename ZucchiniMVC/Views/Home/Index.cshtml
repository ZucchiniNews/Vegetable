@using ZucchiniCore.Entities
@model IEnumerable<Article>

@{
    ViewData["Title"] = "Articles Index";
}

<section class="latest-news-section">
    <h2>Latest News</h2>

    <div class="news-grid">
        @foreach (var article in Model)
        {
            <partial name="_NewscardPartial" model="article" />
        }
    </div>
</section>