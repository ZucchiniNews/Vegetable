@model Zucchinimvc.Models.ViewModels.WeatherViewModel

<form method="get">
    <input type="text" name="city" placeholder="Enter city" />
    <button type="submit">Search</button>
</form>

@if (Model != null)
{
    <div class="current-weather">
        <h2>@Model.City</h2>
        <img src="@Model.IconUrl" />
        <p>Current temperature: @Model.Temp °C</p>
        <p>Description: @Model.Description</p>
    </div>

    <hr />

    <div class="charts-grid">
        @foreach (var cityChart in Model.Cities)
        {
            <div class="chart-card">
                <h3>@cityChart.City</h3>
                <canvas id="chart-@cityChart.City.Replace(" ", "-")"></canvas>
            </div>
        }
    </div>
}

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>

<script>
    const cityData = @Html.Raw(Json.Serialize(Model.Cities));
    
    // 1. Find the Global Min and Max across all cities
    let allTemps = cityData.flatMap(c => c.temperatures);
    let globalMin = Math.floor(Math.min(...allTemps) - 2); // Buffer of 2 degrees
    let globalMax = Math.ceil(Math.max(...allTemps) + 2);  // Buffer of 2 degrees

    cityData.forEach(city => {
    const canvasId = `chart-${city.city.replace(/\s+/g, '-')}`;
    const ctx = document.getElementById(canvasId);
    if (!ctx) return;

    new Chart(ctx, {
    type: 'line',
    data: {
    labels: city.labels,
    datasets: [{
    label: 'Temp (°C)',
    data: city.temperatures,
    borderColor: '#3498db',
    backgroundColor: 'rgba(52, 152, 219, 0.1)',
    fill: true,
    borderWidth: 2,
    pointRadius: 0, // Cleaner look
    tension: 0.3
    }]
    },
    options: {
    responsive: true,
    maintainAspectRatio: false,
    scales: {
    x: {
    type: 'time',
    time: {
    unit: 'hour',
    displayFormats: { hour: 'HH:mm' }
    },
    ticks: {
    source: 'auto',
    maxTicksLimit: 5,
    color: '#666'
    }
    },
    y: {
    // 2. Use the dynamic boundaries
    min: globalMin,
    max: globalMax,
    ticks: { stepSize: 5 },
    title: { display: true, text: '°C' }
    }
    },
    plugins: {
    legend: { display: false }
    }
    }
    });
    });
</script>