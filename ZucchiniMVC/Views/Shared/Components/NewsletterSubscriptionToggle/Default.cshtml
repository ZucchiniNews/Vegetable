@model Zucchinimvc.Models.ViewModels.NewsletterSubscriptionToggleViewModel

<form method="post" asp-controller="Subscription" asp-action="ChangeNewsletter" class="d-flex flex-column gap-3">
    <div class="form-check form-switch">
        <input class="form-check-input" type="checkbox" id="subscribe" name="subscribe" value="true" @(Model.IsSubscribed ? "checked" : null) />
        <label class="form-check-label fw-semibold" for="subscribe">
            Subscribe to newsletter
        </label>
    </div>

    <div class="text-muted small">
        Turn this off if you no longer want newsletter emails.
    </div>

    <button type="submit" class="btn btn-primary rounded-pill px-4 align-self-start">
        Save newsletter preference
    </button>
</form>
