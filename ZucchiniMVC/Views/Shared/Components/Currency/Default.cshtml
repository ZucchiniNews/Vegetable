@model Dictionary<string, decimal>

<div class="currency-widget">
    @if (Model != null && Model.Any())
    {
        <div class="currency-rates">
            @foreach (var rate in Model)
            {
                <div class="currency-item">
                    <span class="currency-symbol">@rate.Key:</span>
                    <span class="currency-value">@rate.Value.ToString("0.0000")</span>
                </div>
            }
        </div>
    }
    else
    {
        <div class="currency-error">Rates unavailable</div>
    }
</div>