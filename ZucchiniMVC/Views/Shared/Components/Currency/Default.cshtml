@model Zucchinimvc.Models.ViewModels.CurrencyWidgetViewModel

@if (!Model.HasError && Model.Rates != null && Model.Rates.Any())
{
    <div class="currency-bar">
        <div class="currency-bar-content">
            <span class="currency-label">RATES</span>
            
            @if (Model.Rates.ContainsKey("SEK"))
            {
                <span class="currency-pair">
                    <span>USD/SEK</span>
                    <strong>@Model.Rates["SEK"].ToString("N3")</strong>
                </span>
            }
            
            @if (Model.Rates.ContainsKey("EUR"))
            {
                <span class="currency-pair">
                    <span>USD/EUR</span>
                    <strong>@Model.Rates["EUR"].ToString("N3")</strong>
                </span>
            }
            
            @if (Model.Rates.ContainsKey("SEK") && Model.Rates.ContainsKey("EUR"))
            {
                <span class="currency-pair">
                    <span>EUR/SEK</span>
                    <strong>@((Model.Rates["SEK"] / Model.Rates["EUR"]).ToString("N3"))</strong>
                </span>
            }
        </div>
    </div>
}

<style>
    .currency-bar {
        border-top: 1px solid #e0e0e0;
        border-bottom: 1px solid #e0e0e0;
        background: #f8f9fa;
        padding: 6px 0;
    }
    
    .currency-bar-content {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 20px;
        display: flex;
        align-items: center;
        gap: 25px;
        flex-wrap: wrap;
    }
    
    .currency-label {
        font-weight: 700;
        color: #ffd700;
        background: #2c3e50;
        padding: 3px 8px;
        border-radius: 3px;
        font-size: 11px;
    }
    
    .currency-pair {
        font-size: 13px;
        color: #555;
    }
    
        .currency-pair span {
            margin-right: 6px;
        }
    
        .currency-pair strong {
            color: #1a1a1a;
            font-family: monospace;
        }
</style>