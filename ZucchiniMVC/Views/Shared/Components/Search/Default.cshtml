@model IEnumerable<Zucchinimvc.Models.DTOs.SearchDTOs.ArticlesSearchResultDTO>

<div class="dropdown-menu show w-100 shadow-lg" style="min-width: 100%; max-width: 500px; z-index: 1050; max-height: 450px; overflow-y: auto; border: 1px solid #e9ecef; border-radius: 0 0 8px 8px; border-top: none; top: 100% !important; left: 0 !important;">
    @if (Model.Any())
    {
        @foreach (var article in Model.Take(5))
        {
            <a class="dropdown-item d-flex align-items-start" 
               asp-controller="Home" 
               asp-action="Article" 
               asp-route-slug="@article.Slug" 
               style="padding: 14px 16px; border-bottom: 1px solid #f0f0f0; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); cursor: pointer;"
               onmouseover="this.style.backgroundColor='#f8f9fa'; this.style.borderBottomColor='#e0e0e0'; this.style.paddingLeft='20px';"
               onmouseout="this.style.backgroundColor='transparent'; this.style.borderBottomColor='#f0f0f0'; this.style.paddingLeft='16px';">
                
                <div style="flex: 1; min-width: 0;">
                    <div class="fw-500" style="font-size: 15px; line-height: 1.5; color: #212529; word-break: break-word; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                        @article.Title
                    </div>
              
                </div>
                
                <div style="flex-shrink: 0; margin-left: 12px; color: #0d6efd; opacity: 0; transition: opacity 0.25s ease;">
                    <i class="fas fa-arrow-right"></i>
                </div>
            </a>
        }
    }
    else
    {
        <div class="text-center py-4" style="color: #6c757d;">
            <i class="fas fa-search" style="font-size: 24px; margin-bottom: 8px; opacity: 0.5; display: block;"></i>
            <span style="font-size: 14px;">No matching articles found.</span>
        </div>
    }
</div>

<style>
    .dropdown-item:last-child {
        border-bottom: none !important;
    }
    
    a.dropdown-item:hover div[style*="flex-shrink"] {
        opacity: 1 !important;
    }
</style>
