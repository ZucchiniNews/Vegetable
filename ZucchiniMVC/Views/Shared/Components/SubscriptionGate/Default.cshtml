
@using Zucchinimvc.Models.ViewModels
@model SubscriptionGateViewModel

@if (Model.IsSubscribed)
{
    <p>@Model.Body</p>
}
else
{
    <div class="border rounded p-5 text-center bg-light mt-4">
        <h4 class="fw-bold mb-2">This content is for subscribers only</h4>
        <p class="text-muted mb-4">
            Subscribe to get full access to this article and all premium content.
        </p>
        <a asp-controller="Subscription" asp-action="Index" class="btn btn-primary px-4">
            Subscribe Now
        </a>
    </div>
}