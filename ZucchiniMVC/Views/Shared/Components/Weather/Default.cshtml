@model Zucchinimvc.Models.ViewModels.WeatherViewModel

@if (Model != null && !string.IsNullOrEmpty(Model.Icon))
{
    <a asp-controller="Weather"
       asp-action="Index"
       asp-route-city="@Model.City"
       class="d-flex align-items-center text-decoration-none text-dark text-nowrap">
        
        <img src="@Model.IconUrl" style="width:40px;" alt="Weather Icon" class="me-2" />
        
        <div class="d-flex flex-column lh-1">
            <span class="fw-bold" style="font-size: 0.85rem;">@Model.City</span>
            <span class="text-muted" style="font-size: 0.75rem;">@Model.Temp °C</span>
        </div>
    </a>
}
