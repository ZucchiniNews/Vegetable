@model Zucchinimvc.Models.ViewModels.WeatherViewModel

    @if (Model != null && !string.IsNullOrEmpty(Model.Icon))
    {
    <a asp-controller="Weather"
           asp-action="Index"
           asp-route-city="@Model.City"
           class="d-flex align-items-center text-decoration-none text-dark text-nowrap">
        <span class="me-1">@Model.City Now:</span>
        <img src="@Model.IconUrl" style="width:40px;" alt="Weather Icon" />
        <span class="ms-1">@Model.Temp °C</span>
    </a>
    }
