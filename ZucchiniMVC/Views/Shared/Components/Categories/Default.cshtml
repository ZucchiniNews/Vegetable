@using Zucchinimvc.Models.ViewModels
@model CategoriesViewModel

<ul class="navbar-nav news-nav-links">

    @foreach (var category in Model.VisibleCategories)
    {
        var isActive = Model.CurrentSlug == category.Slug;

        <li class="nav-item">
            <a class="nav-link @(isActive ? "active" : "")"
               asp-controller="Home"
               asp-action="Category"
               asp-route-slug="@category.Slug">
                @category.Name
            </a>
        </li>
    }

    @if (Model.ExtraCategories.Any())
    {
        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle"
               href="#"
               role="button"
               data-bs-toggle="dropdown">
                More
            </a>

            <ul class="dropdown-menu">
                @foreach (var category in Model.ExtraCategories)
                {
                    <li>
                        <a class="dropdown-item"
                           asp-controller="Home"
                           asp-action="Category"
                           asp-route-slug="@category.Slug">
                            @category.Name
                        </a>
                    </li>
                }
            </ul>
        </li>
    }

</ul>