@using Zucchinimvc.Models.ViewModels
@model ArticleCardViewModel

<a href="/article/@Model.Article.Slug" class="editor-card latest-card">
    <div class="editor-card-image">
        <img src="@Model.Article.Cover?.DisplayUrl" alt="@Model.Article.Title" />
    </div>
    <div class="editor-card-body">
        <div class="latest-title-row">
            <h3 class="card-title">@Model.Article.Title</h3>
            <span class="card-category">@Model.Article.Category?.Name.ToUpper()</span>
        </div>
        <p class="card-excerpt">@(Model.Article.ContentSummary?.Length > 100 ? (Model.Article.ContentSummary[..100] + "…") : Model.Article.ContentSummary)</p>
        <div class="card-meta">
            <span>📅 @Model.Article.PublishedAt.ToString("MMM d, yyyy")</span>
            <span>🕐 @Model.ReadTimeMin min read</span>
        </div>
    </div>
</a>