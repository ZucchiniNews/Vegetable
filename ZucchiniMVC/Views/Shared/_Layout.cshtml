<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZucchiniNews</title>

    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/Zucchinimvc.styles.css" asp-append-version="true" />
</head>

<body class="news-body d-flex flex-column min-vh-100">



<header class="news-header">
    <nav class="navbar navbar-expand-lg news-navbar">
        <div class="container news-navbar-container">

            <!-- Brand -->
            <a class="navbar-brand news-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="news-brand-icon">
                    <img src="~/images/site_logo.png" alt="Logo" />
                </span>
            </a>

            <!-- Toggle -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar content -->
   <!-- Navbar content -->
<div class="collapse navbar-collapse" id="mainNavbar">
    <div class="d-lg-flex w-100 justify-content-between align-items-center">

        <!-- Categories -->
        @await Component.InvokeAsync("Categories")

        <!-- Right side -->
        <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0 news-header-right">
            
            <div class="weather-header-box text-nowrap">
                @await Component.InvokeAsync("Weather", new { city = Context.Request.Query["city"].ToString() })
            </div>
            <div class="login-header-box">
                @await Html.PartialAsync("_LoginPartial")
            </div>
        </div>

    </div>
</div>

        </div>
    </nav>
</header>

<!-- SEARCH BANNER -->
<div class="search-banner" style="background: linear-gradient(135deg, #f8f9fa 0%, #ffffff 100%); border-bottom: 1px solid #e9ecef; padding: 16px 0;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-8 col-md-10">
                <div class="search-banner-content">
                    <div class="search-header-box position-relative w-100">
                        <div class="d-flex justify-content-center gap-2">
                            <div class="flex-grow-1" style="max-width: 500px;">
                                <div class="input-group">
                                    <input type="text"
                                           id="searchInput"
                                           class="form-control"
                                           placeholder="Search articles..."
                                           autocomplete="off"
                                           style="border-radius: 6px 0 0 6px; border: 1px solid #ddd; padding: 10px 14px;" />
                                    <button type="button" id="searchButton" class="btn btn-primary" style="border-radius: 0 6px 6px 0;">
                                        <i class="bi bi-search"></i> Search
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div id="searchResultsDropdown" class="position-absolute w-100" style="left: 50%; transform: translateX(-50%); max-width: 500px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="currency-widget-container">
        <div class="container">
            <div class="currency-wrapper">
                @await Component.InvokeAsync("Currency")
            </div>
        </div>
    </div>

<main class="news-main flex-grow-1">
    <div class="container">

        @RenderBody()

    </div>
</main>
    
<footer class="news-footer">
    <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
        <span>&copy; 2026 - ZucchiniNews</span>
        <a asp-area="" asp-controller="Home" asp-action="Privacy" class="footer-link">Privacy</a>
    </div>
</footer>
 
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
    (() => {
        const input = document.getElementById('searchInput');
        const button = document.getElementById('searchButton');
        const results = document.getElementById('searchResultsDropdown');
        const searchSuggestionsUrl = '@Url.Action("SearchSuggestions", "Home")';
        const debounceDelayMs = 250;
        let debounceTimer;
        let currentSearchController;

        if (!input || !results) return;

        const renderResults = async () => {
            const query = input.value.trim();
            if (!query) {
                if (currentSearchController) {
                    currentSearchController.abort();
                    currentSearchController = null;
                }
                results.innerHTML = '';
                return;
            }

            if (currentSearchController) {
                currentSearchController.abort();
            }

            currentSearchController = new AbortController();
            const { signal } = currentSearchController;

            results.innerHTML = '<div class="dropdown-menu show w-100 shadow-sm mt-2"><span class="dropdown-item-text text-muted py-2">Searching...</span></div>';

            try {
                const response = await fetch(`${searchSuggestionsUrl}?query=${encodeURIComponent(query)}`, { signal });
                if (!response.ok) {
                    results.innerHTML = '<div class="dropdown-menu show w-100 shadow-sm mt-2"><span class="dropdown-item-text text-muted py-2">Search unavailable.</span></div>';
                    return;
                }

                results.innerHTML = await response.text();
            } catch (error) {
                if (error.name === 'AbortError') {
                    return;
                }

                results.innerHTML = '<div class="dropdown-menu show w-100 shadow-sm mt-2"><span class="dropdown-item-text text-muted py-2">Search unavailable.</span></div>';
            } finally {
                if (currentSearchController?.signal === signal) {
                    currentSearchController = null;
                }
            }
        };

        const scheduleRenderResults = () => {
            clearTimeout(debounceTimer);
            debounceTimer = setTimeout(() => {
                renderResults();
            }, debounceDelayMs);
        };

        input.addEventListener('input', scheduleRenderResults);
        input.addEventListener('keydown', (e) => {
            if (e.key === 'Enter') {
                e.preventDefault();
                clearTimeout(debounceTimer);
                renderResults();
            }
        });

        button?.addEventListener('click', () => {
            clearTimeout(debounceTimer);
            renderResults();
        });
    })();
</script>

@await RenderSectionAsync("Scripts", required: false)
@await Component.InvokeAsync("CookieConsent")
</body>
</html>
