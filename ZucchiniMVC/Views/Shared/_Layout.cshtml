<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZicchiniNews</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Zucchinimvc.styles.css" asp-append-version="true" />
</head>
<body class="news-body d-flex flex-column min-vh-100">
    @using Zucchinimvc.Application.Services.CMS
@inject ICmsService CmsService
@{
        var categories = await CmsService.GetCategories();
    }
    <header class="news-header sticky-top">
        <nav class="navbar navbar-expand-lg news-navbar">
            <div class="container news-navbar-container">
                <a class="navbar-brand news-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="news-brand-icon">
                        <img src="~/images/site_logo.png" />
                    </span>
                    <span class="news-brand-text">ZicchiniNews</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                @{
                    var visibleCategories = categories?.Take(4).ToList();
                    var hiddenCategories = categories?.Skip(4).ToList();
                }
                @{
                    var city = Context.Request.Query["city"].ToString();
                }
                <div class="collapse navbar-collapse d-flex align-items-center gap-1" id="mainNavbar">
                    <div class="news-nav-wrapper">
                        <ul class="navbar-nav news-nav-links">
                            
                            @if (categories != null)
                                @foreach (var category in visibleCategories)
                                {
                                    var isActive = ViewContext.RouteData.Values["slug"]?.ToString() == category.Slug;
                                    <li class="nav-item">
                                        <a class="nav-link @(isActive ? "active" : "")"
                                               asp-controller="Home" asp-action="Category"
                                               asp-route-slug="@category.Slug">
                                            @category.Name
                                        </a>
                                    </li>
                                }

                            @if (hiddenCategories != null && hiddenCategories.Any())
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle"
                                           href="#"
                                           role="button"
                                           data-bs-toggle="dropdown"
                                           aria-expanded="false">
                                        More
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        @foreach (var category in hiddenCategories)
                                        {
                                            <li>
                                                <a class="dropdown-item"
                                                       asp-controller="Home"
                                                       asp-action="Category"
                                                       asp-route-slug="@category.Slug">
                                                    @category.Name
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </li>
                            }
                        </ul>
                    </div>
                    <div class="d-flex align-items-center gap-3 news-header-right">
                        <div class="weather-header-box text-nowrap">
                            @await Component.InvokeAsync("Weather", new { city })
                        </div>
                        <div class="login-header-box">
                            @await Html.PartialAsync("_LoginPartial")
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="news-main flex-grow-1">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="news-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
            <span>&copy; 2026 - ZicchiniNews</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="footer-link">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>