<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ZicchiniNews</title>
    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/weather-dashboard.css" />
    <link rel="stylesheet" href="~/Zucchinimvc.styles.css" asp-append-version="true" />
</head>
<body class="news-body d-flex flex-column min-vh-100">
    <header class="news-header sticky-top">
        <nav class="navbar navbar-expand-lg news-navbar">
            <div class="container news-navbar-container">
                <a class="navbar-brand news-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="news-brand-icon">📰</span>
                    <span class="news-brand-text">ZicchiniNews</span>
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
               
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto ms-3 news-nav-links">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Local" ? "active" : "")"
                               asp-controller="Home" asp-action="Local">Local</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Sweden" ? "active" : "")"
                               asp-controller="Home" asp-action="Sweden">Sweden</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "World" ? "active" : "")"
                               asp-controller="Home" asp-action="World">World</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["action"]?.ToString() == "Sport" ? "active" : "")"
                               asp-controller="Home" asp-action="Sport">Sport</a>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center gap-3 news-header-right">
                        <div class="weather-header-box text-nowrap">
                            @{
                                var city = Context.Request.Query["city"].ToString();
                            }
                            @await Component.InvokeAsync("Weather", new { city })
                        </div>
                        <div class="currency-header-box text-nowrap">
                            @await Component.InvokeAsync("Currency")
                        </div>
                        <div class="login-header-box">
                            @await Html.PartialAsync("_LoginPartial")
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="news-main flex-grow-1">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="news-footer">
        <div class="container d-flex flex-column flex-md-row justify-content-between align-items-center">
            <span>&copy; 2026 - ZicchiniNews</span>
            <a asp-area="" asp-controller="Home" asp-action="Privacy" class="footer-link">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>