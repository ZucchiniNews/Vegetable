@model Zucchinimvc.Areas.Identity.Pages.Account.Manage.IndexModel.InputModel

<div class="mb-3">
    <label asp-for="Email" class="form-label small fw-bold text-uppercase"></label>
    <div class="input-group">
        <input asp-for="Email" class="form-control rounded-3" disabled />
        <span class="input-group-text text-success">✓</span>
    </div>
</div>

<div class="mb-3">
    <label asp-for="NewEmail" class="form-label small fw-bold text-uppercase"></label>
    <input asp-for="NewEmail" class="form-control rounded-3" placeholder="Enter new email" />
    <span asp-validation-for="NewEmail" class="text-danger small"></span>
</div>