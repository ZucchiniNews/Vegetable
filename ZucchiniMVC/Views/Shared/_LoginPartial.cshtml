@using Microsoft.AspNetCore.Identity
@using ZucchiniCore.Entities
@using Zucchinimvc.Models

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

<ul class="navbar-nav align-items-center">
    @if (SignInManager.IsSignedIn(User))
    {
        var user = await UserManager.GetUserAsync(User);

        <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle d-flex align-items-center gap-2 px-3 py-2 rounded-pill border bg-white shadow-sm text-dark fw-semibold profile-trigger"
               href="#"
               id="userDropdown"
               role="button"
               data-bs-toggle="dropdown"
               aria-expanded="false">
                @if (User.IsInRole("Admin"))
                {
                    <span class="avatar-circle admin-avatar">
                        <i class="bi bi-shield-lock-fill"></i>
                    </span>
                    <span class="d-none d-sm-inline">Admin</span>
                }
                else
                {
                    <span class="avatar-circle user-avatar">
                        <i class="bi bi-person-circle"></i>
                    </span>
                }
            </a>

            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-modern shadow border-0 rounded-4 p-2" aria-labelledby="userDropdown">
                <li class="dropdown-header-custom px-3 py-2">
                    <div class="d-flex align-items-center gap-3">
                        <span class="avatar-circle user-avatar flex-shrink-0">
                            <i class="bi bi-person-circle"></i>
                        </span>
                        <div class="min-w-0">
                            <span class="d-block fw-bold text-dark text-truncate">@user?.FirstName @user?.LastName</span>
                            <span class="text-muted small user-email text-truncate d-block">@user?.Email</span>
                        </div>
                    </div>
                </li>

                <li><hr class="dropdown-divider my-2"></li>
                @if (User.IsInRole("Admin"))
                {
                    <li>
                        <a class="dropdown-item rounded-3 py-2 admin-link" asp-controller="Admin" asp-action="Index">
                            <i class="bi bi-shield-lock me-2"></i>Admin Dashboard
                        </a>
                    </li>
                }
                else
                {
                <li>
                    <a class="dropdown-item rounded-3 py-2" asp-area="Identity" asp-page="/Account/Manage/Index">
                        <i class="bi bi-person me-2"></i>Account Settings
                    </a>
                </li>
                }

                <li><hr class="dropdown-divider my-2"></li>

                <li>
                    <form id="logoutForm"
                          class="form-inline"
                          asp-area="Identity"
                          asp-page="/Account/Logout"
                          asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                        <button type="submit" class="dropdown-item rounded-3 py-2 text-danger">
                            <i class="bi bi-box-arrow-right me-2"></i>Log Out
                        </button>
                    </form>
                </li>
            </ul>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link d-flex align-items-center gap-2 px-3 py-2 rounded-pill border bg-white shadow-sm text-dark fw-semibold profile-trigger guest-trigger"
               id="login"
               asp-area="Identity"
               asp-page="/Account/Login">
                <span class="avatar-circle guest-avatar">
                    <i class="bi bi-person-circle"></i>
                </span>
                <span>Log In</span>
            </a>
        </li>
    }
</ul>
