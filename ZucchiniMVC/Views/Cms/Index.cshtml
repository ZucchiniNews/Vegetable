@model IEnumerable<ZucchiniCore.Entities.Article>

@{
    ViewData["Title"] = "CMS Articles";
}

<h1>CMS Articles</h1>

<table class="table">
    <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Description</th>
            <th>Slug</th>
            <th>Published Date</th>
            <th>Cover</th>
        </tr>
    </thead>
    <tbody>
@if (Model != null)
{
    @foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Title)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ContentSummary)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Slug)
            </td>
            <td>
                @item.PublishedAt.ToShortDateString()
            </td>
            <td>
                @if (item.Cover != null && !string.IsNullOrEmpty(item.Cover.Url))
                {
                    <img src="@item.Cover.Url" alt="Cover" style="max-height: 50px; max-width: 50px;" />
                }
            </td>
        </tr>
    }
}
    </tbody>
</table>
