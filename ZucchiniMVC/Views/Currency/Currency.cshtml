@model Zucchinimvc.Models.ViewModels.CurrencyGraphViewModel

@{
    ViewData["Title"] = "Currency Rates";

    var selectedRates = Model.Rates
        .Where(r => new[] { "SEK", "EUR" }.Contains(r.Key))
        .ToDictionary(r => r.Key, r => r.Value);
}

<h1>Currency Rates</h1>

<p>
    Base Currency: <strong>@Model.BaseCurrency</strong>
</p>

<div style="width: 100%; max-width: 900px;">
    <canvas id="currencyChart"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const labels = @Html.Raw(Json.Serialize(selectedRates.Keys));
    const values = @Html.Raw(Json.Serialize(selectedRates.Values));

    const ctx = document.getElementById('currencyChart');

    new Chart(ctx, {
    type: 'bar',
    data: {
    labels: labels,
    datasets: [{
    label: 'Exchange Rates from @Model.BaseCurrency',
    data: values,
    borderWidth: 1
    }]
    },
    options: {
    responsive: true,
    scales: {
    y: {
    beginAtZero: true
    }
    }
    }
    });
</script>