@using ZucchiniCore.Entities
@model IEnumerable<User>
@{
    ViewData["Title"] = "Manage Users";
}
@if (User.IsInRole("Admin"))
{
    <div class="container mt-4">
        <h2 class="mb-4">Manage Users</h2>

        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Id</th>
                    <th>Email</th>
                    <th>First Name</th>
                    <th>Last Name</th>
                    <th>Newsletter Subscribed</th>
                    <th>Actions?</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                @foreach (var user in Model)
                {
                <tr>
                    <td>@user.Id</td>
                    <td>@user.Email</td>
                    <td>@user.FirstName</td>
                    <td>@user.LastName</td>
                    <td>@user.NewsletterSubscribed</td>
                    <td>
                        <a href="@Url.Action("EditUser", new { id = user.Id })" class="btn btn-sm btn-outline-primary">Edit</a>
                        <a href="@Url.Action("DeleteUser", new { id = user.Id })" class="btn btn-sm btn-outline-danger">Delete</a>
                    </td>
                </tr>
                } 
            </tbody>
        </table>
    </div>
}
