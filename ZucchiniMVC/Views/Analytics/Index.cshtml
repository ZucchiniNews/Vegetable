@model Zucchinimvc.Models.DTOs.Analytic.AnalyticsSummaryDto

@{
    ViewData["Title"] = "Analytics Dashboard";
}

<div class="container py-4">
    <h1 class="mb-4">Analytics Dashboard</h1>
    <p class="text-muted mb-4">Last 30 days</p>

    <div class="row g-4 mb-5">
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-muted small mb-1">Total Views</p>
                    <h2 class="fw-bold">@Model.Views</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-muted small mb-1">Unique Visitors</p>
                    <h2 class="fw-bold">@Model.UniqueVisitors</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-muted small mb-1">New Subscriptions</p>
                    <h2 class="fw-bold">@Model.NewSubscriptions</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <p class="text-muted small mb-1">Cancelled Subscriptions</p>
                    <h2 class="fw-bold">@Model.CanceledSubscriptions</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-header">
            <h5 class="mb-0">Top Articles</h5>
        </div>
        <div class="card-body p-0">
            @if (Model.TopArticles.Any())
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Article</th>
                            <th class="text-end">Views</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var article in Model.TopArticles)
                        {
                            <tr>
                                <td>@article.ResourceId</td>
                                <td class="text-end">@article.ViewCount</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }